{
  "name": "financial-research-team",
  "version": "1.0.0",
  "description": "Private, source-backed market research workspace with scoped Grok ingestion and Supabase persistence",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_DEMO_MODE=true vite build --outDir dist-demo",
    "preview": "vite preview",
    "preview:demo": "npm run build:demo && vite preview --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev:demo": "VITE_DEMO_MODE=true vite",
    "check:edge": "tsc -p supabase/functions/tsconfig.json",
    "test:load": "tsx scripts/measure-search.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:client": "python3 -m unittest discover -s tests -p test_client.py",
    "cli:install": "bash scripts/install-supabase.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewMastando/financial-research-team.git"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MatthewMastando/financial-research-team/issues"
  },
  "homepage": "https://github.com/MatthewMastando/financial-research-team#readme",
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "private": true
}
